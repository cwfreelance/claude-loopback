{
  "name": "claude-loopback",
  "version": "0.1.0",
  "private": true,
  "description": "Call Claude Code from your own scripts over a localhost-only HTTP API (personal use)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssaarthakk/claude-loopback.git"
  },
  "homepage": "https://github.com/ssaarthakk/claude-loopback#readme",
  "bugs": {
    "url": "https://github.com/ssaarthakk/claude-loopback/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "openapi": "node scripts/write-openapi.ts",
    "setup": "node scripts/setup.ts",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node --env-file-if-exists=.env scripts/e2e.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  }
}
