# Copy to .env and fill in LOOPBACK_TOKEN. `pnpm dev` and `pnpm start` load .env automatically.
# Every other variable is optional; the values shown are the defaults.

# Required. Bearer token clients must send. At least 32 characters: `pnpm run token`.
LOOPBACK_TOKEN=

# Bind address. Only 127.0.0.1 is accepted (loopback only, by design).
# LOOPBACK_HOST=127.0.0.1
# Port to listen on (0 = pick a free port).
# LOOPBACK_PORT=7337

# Absolute path to claude.exe. Default: found on PATH. .cmd/.bat shims are rejected.
# LOOPBACK_CLAUDE_PATH=

# Claude processes allowed to run at once, and how many requests may wait for a slot.
# LOOPBACK_MAX_CONCURRENCY=2
# LOOPBACK_QUEUE_SIZE=10
# Longest a request may wait in the queue before 503 queue_timeout.
# LOOPBACK_QUEUE_TIMEOUT_MS=60000

# Run time per request: default, and the most a request may ask for via timeoutMs.
# LOOPBACK_DEFAULT_TIMEOUT_MS=120000
# LOOPBACK_MAX_TIMEOUT_MS=600000

# Comma-separated Claude Code tools requests may use (plain names, e.g. WebSearch,WebFetch).
# Empty = no tools at all. Requests can only narrow this list.
# LOOPBACK_ALLOWED_TOOLS=
# Comma-separated model aliases/ids requests may pick.
# LOOPBACK_ALLOWED_MODELS=sonnet,opus,haiku,fable
# Model used when a request names none; must be in the list above. Default: the first one.
# LOOPBACK_DEFAULT_MODEL=sonnet

# Largest accepted request body in bytes (max 8 MiB).
# LOOPBACK_MAX_BODY_BYTES=4194304
# Requests per minute across all clients.
# LOOPBACK_RATE_LIMIT_PER_MIN=30

# How long a streaming client may stop reading before its stream and run are dropped (ms).
# LOOPBACK_STREAM_STALL_MS=30000

# Comma-separated browser origins allowed to call the API. Empty = browsers blocked.
# LOOPBACK_CORS_ORIGINS=

# fatal | error | warn | info | debug | trace | silent
# LOOPBACK_LOG_LEVEL=info
# Log prompt and output contents. Local debugging only; credentials stay redacted.
# LOOPBACK_LOG_PROMPTS=false
